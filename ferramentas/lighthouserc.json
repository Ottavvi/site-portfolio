{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/index.html",
        "http://localhost/sobre.html",
        "http://localhost/pousada.html",
        "http://localhost/paineis.html",
        "http://localhost/en/index.html",
        "http://localhost/estudos/index.html",
        "http://localhost/estudos/html/o-que-e-html.html",
        "http://localhost/estudos/html/desafio-sobre-mim.html"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.85 }]
      }
    }
  }
}
