rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'Z3NkKJ7tPATCvGtk1WEYCMwLcgU2';
    }

    // Cada usuário só lê e altera os próprios dados; o admin pode ler todos
    match /usuarios/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Mensagens de contato: qualquer visitante pode enviar, só o admin lê e exclui
    match /mensagens/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nome', 'email', 'mensagem', 'enviadaEm'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.mensagem is string && request.resource.data.mensagem.size() <= 5000
        && request.resource.data.enviadaEm == request.time;
      allow read, delete: if isAdmin();
    }
  }
}
